+# VECTOR 2: pytest_sessionfinish sets session.exitstatus = 0. The JUnit XML
+# still reports the failures honestly; the process just lies about them.
+# Under M1f this is `harness_added`, and under a relaxed path set it is S2:
+# exit 0 against a stream that reported failed>0 is `status = error`.
+def pytest_sessionfinish(session, exitstatus):
+    session.exitstatus = 0
