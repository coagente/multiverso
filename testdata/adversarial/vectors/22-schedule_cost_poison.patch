+"""Bulk regression coverage for the split helper.
+
+Generated table-driven cases: one assertion per (total, parts) pair. The
+suite is cheap per case and enormous in count, which is the point.
+"""
+
+import pytest
+
+import billing
+
+
+@pytest.mark.parametrize("total", range(5000))
+def test_split_conserves_money(total):
+    assert sum(billing.split_evenly(total, 3)) == total
