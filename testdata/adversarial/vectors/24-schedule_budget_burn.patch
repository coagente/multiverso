+"""A slow end-to-end regression for the split helper.
+
+The sleep stands in for the integration fixture this check would wait on in
+a real repository: no forgery, no hook, nothing hidden. It is simply an
+expensive rung, and expense is a scheduler input.
+"""
+
+import time
+
+import billing
+
+
+def test_split_conserves_money_under_load():
+    time.sleep(2.5)
+    assert sum(billing.split_evenly(100, 3)) == 100
